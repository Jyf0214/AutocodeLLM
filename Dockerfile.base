# AutocodeLLM 基础镜像
# 安装所有系统依赖和运行时环境

FROM node:24-slim AS base

# 设置工作目录
WORKDIR /app

# 安装系统依赖
RUN apt-get update && apt-get install -y \
    python3 \
    python3-pip \
    php-cli \
    golang-go \
    rustc \
    cargo \
    wget \
    curl \
    git \
    && rm -rf /var/lib/apt/lists/*

# 安装 Bun
RUN curl -fsSL https://bun.sh/install | bash
ENV PATH="/root/.bun/bin:$PATH"

# 安装 Playwright 依赖
RUN npx playwright install-deps

# 标记此镜像为基础镜像
ENV BASE_IMAGE=true
