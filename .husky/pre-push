#!/bin/sh
# pre-push — 推送前全量扫描所有源文件的版权头
# 最后一层本地防线，防止问题流到远程

# 消耗 stdin（git push 传入的 ref 信息），避免脚本被多次触发
while read -r line; do :; done

bash scripts/pre-commit-copyright.sh --full-scan || {
  echo ''
  echo '===================================================='
  echo '版权检查未通过，已阻止推送！'
  echo ''
  echo '修复后重新推送，或使用 git push --no-verify 跳过'
  echo '===================================================='
  exit 1
}
