#!/usr/bin/env bash

echo "🔍 开始 Pre-push 检查..."
echo ""

# ============================================================
# 1️⃣ TypeScript 类型检查
# ============================================================
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo "  1️⃣  类型检查 (TypeScript)"
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
if ! npx tsc --noEmit --skipLibCheck 2>&1; then
  echo ""
  echo "❌ TypeScript 类型检查失败，推送中止！"
  echo "   使用 --no-verify 可跳过本次检查。"
  exit 1
fi
echo "✅ 类型检查通过"
echo ""

# ============================================================
# 2️⃣ 构建检查（需要 DATABASE_URL 等环境变量）
# ============================================================
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo "  2️⃣  构建检查 (next build)"
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"

# prisma generate + next build 需要 DATABASE_URL
if [ -z "${DATABASE_URL:-}" ]; then
  echo "⚠️  DATABASE_URL 未设置，跳过构建检查。"
  echo "   确保 CI/CD 中已配置环境变量。"
else
  # prisma generate
  echo "  → 生成 Prisma Client..."
  if ! npx prisma generate --no-hints 2>&1; then
    echo ""
    echo "❌ Prisma 生成失败，推送中止！"
    exit 1
  fi
  echo "  ✅ Prisma 生成通过"

  # next build（使用 --no-lint 因为 lint 已在 pre-commit 中检查）
  echo "  → 构建 Next.js 项目..."
  if ! npx next build --no-lint 2>&1; then
    echo ""
    echo "❌ 构建失败，推送中止！"
    exit 1
  fi
  echo "  ✅ 构建通过"
fi

echo ""
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo "  ✅ Pre-push 检查全部通过"
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
