#!/usr/bin/env bash

set -euo pipefail

echo "🔍 开始 Pre-push 检查..."
echo ""

# 构建需要 DATABASE_URL，未设置时使用默认值
# 编译阶段使用延迟导入（lazy import），默认值仅用于通过 Prisma Client 生成
export DATABASE_URL="${DATABASE_URL:-mysql://user:password@localhost:3306/autocodellm}"

# ============================================================
# 1️⃣ 构建检查
# ============================================================
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo "  1️⃣  构建检查"
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"

# --- Prisma Client 生成 ---
echo "  → 生成 Prisma Client..."
NO_UPDATE_NOTIFIER=true npx prisma generate --no-hints 2>&1
echo "  ✅ Prisma 生成通过"
echo ""

# --- Next.js 构建 ---
echo "  → 构建 Next.js 项目..."
NO_UPDATE_NOTIFIER=true npx next build 2>&1
echo "  ✅ 构建通过"
echo ""

echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo "  ✅ Pre-push 检查全部通过"
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
