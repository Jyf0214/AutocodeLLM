#!/usr/bin/env bash

set -euo pipefail

echo "🔍 开始 Pre-push 检查..."
echo ""

# 构建需要 DATABASE_URL，未设置时使用默认值
export DATABASE_URL="${DATABASE_URL:-mysql://user:password@localhost:3306/autocodellm}"

# ============================================================
# 1️⃣ 构建检查（编译阶段）
# ============================================================
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo "  1️⃣  构建检查"
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"

# --- Prisma Client 生成 ---
echo "  → 生成 Prisma Client..."
NO_UPDATE_NOTIFIER=true npx prisma generate --no-hints 2>&1
echo "  ✅ Prisma 生成通过"
echo ""

# --- Next.js 构建（编译通过即视为代码正确，静态生成失败不阻拦） ---
echo "  → 构建 Next.js 项目..."
BUILD_OUTPUT=$(NO_UPDATE_NOTIFIER=true npx next build 2>&1) || true

if echo "$BUILD_OUTPUT" | grep -q "✓ Compiled successfully"; then
  echo "  ✅ 编译通过"
else
  echo ""
  echo "$BUILD_OUTPUT"
  echo ""
  echo "❌ 编译失败，推送已阻拦。"
  exit 1
fi

# 静态生成阶段的错误仅提示，不阻拦（需要真实数据库）
if echo "$BUILD_OUTPUT" | grep -q "Error occurred prerendering page"; then
  PRERENDER_PAGES=$(echo "$BUILD_OUTPUT" | grep "Error occurred prerendering page" | sed 's/.*page "//;s/".*//' | tr '\n' ' ')
  echo "  ⚠️  以下页面静态生成跳过（需要数据库连接）：$PRERENDER_PAGES"
fi

echo "  ✅ 构建通过"
echo ""

echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo "  ✅ Pre-push 检查全部通过"
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
