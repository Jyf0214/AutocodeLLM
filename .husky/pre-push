#!/usr/bin/env bash

set -euo pipefail

echo "🔍 开始 Pre-push 检查..."
echo ""

# ============================================================
# 1️⃣ 构建检查 — 前置条件
# ============================================================
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo "  1️⃣  构建检查"
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"

if [ -z "${DATABASE_URL:-}" ]; then
  echo "⚠️  DATABASE_URL 未设置，跳过构建检查。"
  echo "   确保 CI/CD 中已配置 DATABASE_URL。"
  echo ""

  echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
  echo "  ✅ Pre-push 检查通过（跳过了构建）"
  echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
  exit 0
fi

# --- Prisma Client 生成 ---
echo "  → 生成 Prisma Client..."
NO_UPDATE_NOTIFIER=true npx prisma generate --no-hints 2>&1
echo "  ✅ Prisma 生成通过"
echo ""

# --- Next.js 构建 ---
echo "  → 构建 Next.js 项目..."
NO_UPDATE_NOTIFIER=true npx next build 2>&1
echo "  ✅ 构建通过"
echo ""

echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo "  ✅ Pre-push 检查全部通过"
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
