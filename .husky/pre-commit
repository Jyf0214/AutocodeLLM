#!/usr/bin/env bash

set -euo pipefail

echo "🔍 开始 Pre-commit 检查..."
echo ""

# ============================================================
# 1️⃣ ESLint — staged .ts/.tsx 文件
# ============================================================
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo "  1️⃣  ESLint 代码规范检查"
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"

STAGED_TS=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '\.(ts|tsx)$' || true)
if [ -n "$STAGED_TS" ]; then
  echo "$STAGED_TS" | xargs npx eslint --quiet 2>&1
  echo "✅ ESLint 通过"
else
  echo "（无 staged TS 文件，跳过）"
fi
echo ""

# ============================================================
# 2️⃣ 安全检查
# ============================================================
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo "  2️⃣  安全检查"
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"

STAGED_ENV=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '^\.env$|^\.env\.' | grep -v '\.env\.example' || true)
if [ -n "$STAGED_ENV" ]; then
  echo "❌ 禁止提交环境配置文件：$STAGED_ENV"
  exit 1
fi

SENSITIVE_PATTERNS=(
  "AKIA[0-9A-Z]{16}"
  "sk-[a-zA-Z0-9]{20,}"
  "ghp_[a-zA-Z0-9]{36}"
)
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '\.(ts|tsx|js|jsx|json|yml|yaml)$' || true)
if [ -n "$STAGED_FILES" ]; then
  for pattern in "${SENSITIVE_PATTERNS[@]}"; do
    MATCHES=$(echo "$STAGED_FILES" | xargs grep -l -E "$pattern" 2>/dev/null || true)
    if [ -n "$MATCHES" ]; then
      echo "❌ 检测到敏感信息（$pattern）：$MATCHES"
      exit 1
    fi
  done
fi
echo "✅ 安全检查通过"
echo ""

echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo "  ✅ Pre-commit 全部通过"
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
