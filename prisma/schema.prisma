// AutocodeLLM 数据库 Schema

generator client {
  provider    = "prisma-client-js"
  engineType  = "library"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ============================================================
// 用户与权限
// ============================================================

model User {
  id                  String   @id @default(uuid())
  username            String   @unique @default("admin")
  passwordHash        String
  role                String   @default("admin") // admin, user, viewer
  forceChangePassword Boolean  @default(true)
  isInitialPassword   Boolean  @default(true)

  // 第三方认证绑定
  githubId            String?  @unique // GitHub OAuth/App 的用户ID
  githubUsername      String?  // GitHub 用户名
  clerkId             String?  @unique // Clerk 用户ID
  supabaseId          String?  @unique // Supabase 用户ID

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  passwordAudits PasswordAudit[]
  apiKeys        ApiKey[]

  @@map("users")
}

model PasswordAudit {
  id           String    @id @default(uuid())
  userId       String
  action       String    // PASSWORD_CHANGED, LOGIN_SUCCESS, LOGIN_FAILED
  submittedHash String?
  storedHash   String?
  ipAddress    String?
  userAgent    String?
  success      Boolean   @default(true)
  message      String?
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@map("password_audits")
}

// API Key（用于系统调用 API）
model ApiKey {
  id          String    @id @default(uuid())
  userId      String
  name        String    // 密钥名称
  keyHash     String    @unique // SHA-256 哈希
  prefix      String    // 前 8 位，用于识别
  permissions String    @default("[]") // JSON 数组：["read", "write", "admin"]
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  enabled     Boolean   @default(true)
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([keyHash])
  @@index([userId])
  @@map("api_keys")
}


// ============================================================
// 项目
// ============================================================

model Project {
  id              String    @id @default(uuid())
  name            String
  description     String    @default("")
  accessPassword  String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  logs            ProjectLog[]
  backups         Backup[]
  channels        Channel[]
  discordBindings DiscordBinding[]

  @@index([name])
  @@map("workspaces")
}


// ============================================================
// 环境变量
// ============================================================

model EnvironmentVariable {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String   // 加密存储
  description String   @default("")
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("environment_variables")
}

// ============================================================
// WebDAV 备份
// ============================================================

model WebdavConfig {
  id         String   @id @default(uuid())
  url        String
  username   String
  password   String   // 加密存储
  remotePath String   @default("/autocodellm")
  enabled    Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("webdav_configs")
}

model Backup {
  id          String   @id @default(uuid())
  projectId   String   @map("workspaceId")
  name        String
  size        Int      @default(0)
  status      String   @default("pending") // pending, completed, failed
  createdAt   DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([createdAt])
  @@map("backups")
}

// ============================================================
// 项目日志
// ============================================================

model ProjectLog {
  id          String   @id @default(uuid())
  projectId   String   @map("workspaceId")
  type        String   // function_call, chat_message
  functionName String?
  summary     String?
  status      String?  // success, error, pending
  createdAt   DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([createdAt])
  @@map("workspace_logs")
}

// ============================================================
// Discord 集成
// ============================================================

model Channel {
  id               String      @id @default(uuid())
  projectId        String      @map("workspaceId")
  name             String
  discordGuildId   String
  discordChannelId String      @unique
  type             ChannelType @default(TEXT)
  enabled          Boolean     @default(true)
  lastSyncedAt     DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  messages  ChannelMessage[]

  @@index([projectId])
  @@map("channels")
}

model ChannelMessage {
  id           String   @id @default(uuid())
  channelId    String
  discordMsgId String   @unique
  authorId     String
  authorName   String
  authorAvatar String?
  content      String   @db.LongText
  attachments  String?  @db.Text
  sentFromApp  Boolean  @default(false)
  createdAt    DateTime @default(now())

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@index([channelId, createdAt])
  @@map("channel_messages")
}

model DiscordBinding {
  id             String    @id @default(uuid())
  discordUserId  String    @unique
  discordUserName String
  projectId      String    @map("workspaceId")
  code           String?   @unique
  codeExpiresAt  DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([code])
  @@map("discord_bindings")
}

enum ChannelType {
  TEXT
  VOICE
  ANNOUNCEMENT
}

model SystemLog {
  id            String   @id @default(uuid())
  level         String
  message       String   @db.Text
  source        String
  path          String?
  method        String?
  statusCode    Int?
  duration      Int?
  userId        String?
  ip            String?
  queryParams   String?  @db.Text
  requestBody   String?  @db.Text
  responseBody  String?  @db.Text
  cookies       String?  @db.Text
  headers       String?  @db.Text
  errorDetails  String?  @db.Text
  traceId       String?
  functionName  String?
  functionArgs  String?  @db.Text
  functionResult String? @db.Text
  createdAt     DateTime @default(now())

  @@index([createdAt])
  @@index([level])
  @@index([source])
  @@index([traceId])
  @@map("system_logs")
}