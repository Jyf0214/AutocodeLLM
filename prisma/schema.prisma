// AutocodeLLM 数据库 Schema

generator client {
  provider      = "prisma-client-js"
  engineType    = "library"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// 用户认证
model User {
  id                  String   @id @default(uuid())
  username            String   @unique @default("admin")
  passwordHash        String
  forceChangePassword Boolean  @default(true)
  isInitialPassword   Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  passwordAudits    PasswordAudit[]

  @@map("users")
}

// 密码审计日志
model PasswordAudit {
  id              String   @id @default(uuid())
  userId          String
  action          String   // PASSWORD_CHANGED, LOGIN_ATTEMPT, LOGIN_SUCCESS, LOGIN_FAILED
  submittedHash   String?  // 用户提交的密码哈希（用于登录尝试）
  storedHash      String?  // 当时系统存储的哈希值
  ipAddress       String?
  userAgent       String?
  success         Boolean  @default(true)
  message         String?
  createdAt       DateTime @default(now())

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@map("password_audits")
}

// API 提供商配置
model Provider {
  id          String   @id @default(uuid())
  name        String   @unique
  baseUrl     String
  apiKey      String   // 加密存储的 API 密钥
  databaseUrl String?
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("providers")
}

// MCP 服务器配置
model McpServer {
  id        String   @id @default(uuid())
  name      String   @unique
  url       String
  enabled   Boolean  @default(true)
  status    String   @default("disconnected")
  tools     String   @default("[]")  // JSON 字符串
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("mcp_servers")
}

// 聊天全局配置
model ChatConfig {
  id                     String   @id @default(uuid())
  temperature            Float    @default(0.7)
  maxTokens              Int      @default(4096)
  topP                   Float    @default(1.0)
  frequencyPenalty       Float    @default(0.0)
  presencePenalty        Float    @default(0.0)
  maxToolCallsPerMessage Int      @default(10)
  enableStreaming        Boolean  @default(true)
  enableFunctionCall     Boolean  @default(true)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@map("chat_configs")
}

// 工作区
model Workspace {
  id          String   @id @default(uuid())
  name        String
  description String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  messages ChatMessage[]

  @@map("workspaces")
}

// 聊天对话记录
model ChatMessage {
  id          String   @id @default(uuid())
  workspaceId String
  role        String   // user | assistant | system | tool
  content     String   // 内容
  toolCalls   String?  // 工具调用记录 (JSON 字符串)
  toolCallId  String?
  tokensUsed  Int      @default(0)
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([createdAt])
  @@map("chat_messages")
}

// WebDAV 备份配置
model WebdavConfig {
  id         String   @id @default(uuid())
  url        String   // WebDAV 服务器地址
  username   String
  password   String   // 加密存储
  remotePath String   @default("/autocodellm") // 远程路径
  enabled    Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("webdav_configs")
}

// 环境变量
model EnvironmentVariable {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String   // 加密存储
  description String   @default("")
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("environment_variables")
}

// 工作节点
model Worker {
  id           String    @id @default(uuid())
  name         String    @unique
  type         String    // compute, storage, inference
  status       String    @default("offline") // online, offline, busy, error
  url          String
  lastHeartbeat DateTime?
  metadata     String?  // 额外配置信息 (JSON 字符串)
  enabled      Boolean  @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("workers")
}

// 任务代理
model AgentTask {
  id          String   @id @default(uuid())
  name        String
  description String   @default("")
  mode        String   // read_only, yolo
  status      String   @default("ready") // ready, running, completed, failed
  maxAgents   Int      @default(5)
  progress    Int      @default(0)
  logs        String?  // 执行日志 (JSON 字符串)
  result      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("agent_tasks")
}
