{
  "name": "autocodellm",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "module": "index.ts",
  "type": "module",
  "bin": {
    "autocodellm": "scripts/start.mjs"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "prisma generate && next telemetry disable && next build",
    "start": "node scripts/start.mjs",
    "lint": "eslint --max-warnings=0 .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma db push",
    "db:migrate:dev": "prisma db push --accept-data-loss",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:init": "bun run scripts/db-push.mjs",
    "db:health": "bun run src/lib/db/health-check.ts",
    "db:reset": "prisma db push --force-reset && bun run db:init"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "^16.2.2",
    "@playwright/test": "^1.59.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/bun": "latest",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.58.0",
    "@typescript-eslint/parser": "^8.58.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "husky": "^9.1.7",
    "jsdom": "^29.0.1",
    "lint-staged": "^16.4.0",
    "playwright": "^1.59.1",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "typescript-eslint": "^8.58.0",
    "vitest": "^4.1.2"
  },
  "dependencies": {
    "@ant-design/icons": "^6.1.1",
    "@ant-design/nextjs-registry": "^1.3.0",
    "@anthropic-ai/sdk": "^0.82.0",
    "@lobehub/icons": "^5.2.0",
    "@lobehub/ui": "^5.6.4",
    "@prisma/client": "6.19.3",
    "@types/ws": "^8.18.1",
    "antd": "^6.3.5",
    "chokidar": "^4.0.3",
    "fast-glob": "^3.3.3",
    "motion": "^12.38.0",
    "next": "16.2.2",
    "next-intl": "^4.9.0",
    "next-themes": "^0.4.6",
    "node-pty": "^1.1.0",
    "openai": "^6.33.0",
    "prisma": "6.19.3",
    "react": "19",
    "react-dom": "19",
    "react-markdown": "^10.1.0",
    "webdav": "^5.8.0",
    "ws": "^8.20.0",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix"
    ]
  }
}
