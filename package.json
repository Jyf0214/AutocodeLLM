{
  "name": "autocodellm",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "autocodellm": "scripts/start.mjs"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "typecheck": "tsc --noEmit",
    "build": "prisma generate && next telemetry disable && next build",
    "build:full": "bun run build",
    "start": "node scripts/start.mjs",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma db push",
    "db:migrate:dev": "prisma db push --accept-data-loss",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:init": "bun run scripts/db-push.mjs",
    "db:health": "bun run src/lib/db/health-check.ts",
    "db:reset": "prisma db push --force-reset && bun run db:init",
    "terminal": "bun run scripts/terminal-server.ts"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "^16.2.2",
    "@playwright/test": "^1.59.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/bun": "latest",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.58.0",
    "@typescript-eslint/parser": "^8.58.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "happy-dom": "^20.9.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "playwright": "^1.59.1",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "typescript-eslint": "^8.58.0",
    "vitest": "^4.1.2"
  },
  "dependencies": {
    "@ant-design/icons": "^6.1.1",
    "@ant-design/nextjs-registry": "^1.3.0",
    "@anthropic-ai/sdk": "^0.96.0",
    "@clerk/nextjs": "^7.2.9",
    "@clerk/themes": "^2.4.57",
    "@lobehub/icons": "^5.5.4",
    "@octokit/auth-app": "^8.2.0",
    "@octokit/rest": "^22.0.1",
    "@prisma/client": "6.19.3",
    "@types/ws": "^8.18.1",
    "antd": "^6.3.5",
    "chokidar": "^4.0.3",
    "discord.js": "^14.26.3",
    "fast-glob": "^3.3.3",
    "motion": "^12.38.0",
    "next": "^16.2.6",
    "next-intl": "^4.9.2",
    "next-themes": "^0.4.6",
    "openai": "^6.33.0",
    "prisma": "6.19.3",
    "react": "19",
    "react-dom": "19",
    "react-markdown": "^10.1.0",
    "svix": "^1.92.2",
    "webdav": "^5.8.0",
    "ws": "^8.20.0",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0"
  },
  "optionalDependencies": {
    "node-pty": "^1.1.0"
  },
  "overrides": {
    "postcss": "8.5.10"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix"
    ]
  }
}
