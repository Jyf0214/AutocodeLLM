# 数据库
DATABASE_URL="mysql://user:password@localhost:3306/autocodellm"

# MySQL
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=autocodellm
MYSQL_USER=autocode
MYSQL_PASSWORD=autocode
MYSQL_PORT=3306

# 应用
APP_PORT=3000
NODE_ENV=development
DEMO_MODE=false

# 加密密钥（生产环境必须修改为随机值）
# KEY_VAULTS_SECRET: 用于加密用户存储的 apikey 等敏感信息
KEY_VAULTS_SECRET="your-key-vaults-secret-change-in-production"
# AUTH_SECRET: Better Auth 认证密钥（32+ 位随机字符串）
AUTH_SECRET="your-auth-secret-change-in-production"
# JWKS_KEY: 用于签名和验证 JWT（JSON格式，使用 npx gen-jwks 工具生成）
JWKS_KEY='{"keys":[{"d":"YOUR_PRIVATE_KEY","dp":"YOUR_DP","dq":"YOUR_DQ","e":"AQAB","kty":"RSA","n":"YOUR_PUBLIC_KEY","p":"YOUR_P","q":"YOUR_Q","qi":"YOUR_QI","use":"sig","kid":"your-key-id","alg":"RS256"}]}'

# API 密钥
OPENAI_API_KEY=
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
DEEPSEEK_API_KEY=

# 终端 WebSocket 地址（用于 Web 终端功能）
# 本地开发默认: ws://localhost:7860/api/terminal/ws
# Docker 环境默认: ws://localhost:7860/api/terminal/ws
TERMINAL_WS_URL=ws://localhost:7860/api/terminal/ws

# 日志
LOG_LEVEL=info
