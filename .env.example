# 数据库
DATABASE_URL="mysql://user:password@localhost:3306/autocodellm"

# MySQL
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=autocodellm
MYSQL_USER=autocode
MYSQL_PASSWORD=autocode
MYSQL_PORT=3306

# 应用
APP_PORT=3000
NODE_ENV=development
DEMO_MODE=false

# 加密密钥（生产环境必须修改为随机值）
# KEY_VAULTS_SECRET: 用于加密用户存储的 apikey 等敏感信息
KEY_VAULTS_SECRET="your-key-vaults-secret-change-in-production"
# AUTH_SECRET: Better Auth 认证密钥（32+ 位随机字符串）
AUTH_SECRET="your-auth-secret-change-in-production"
# JWKS_KEY: 用于签名和验证 JWT（JSON格式，使用 npx gen-jwks 工具生成）
JWKS_KEY='{"keys":[{"d":"YOUR_PRIVATE_KEY","dp":"YOUR_DP","dq":"YOUR_DQ","e":"AQAB","kty":"RSA","n":"YOUR_PUBLIC_KEY","p":"YOUR_P","q":"YOUR_Q","qi":"YOUR_QI","use":"sig","kid":"your-key-id","alg":"RS256"}]}'

# API 密钥
OPENAI_API_KEY=
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
DEEPSEEK_API_KEY=

# GitHub OAuth（用于 GitHub 登录）
# 启用条件：设置 GITHUB_CLIENT_ID 和 GITHUB_CLIENT_SECRET
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:3000/api/auth/github/callback

# GitHub App（完整集成，用于登录和仓库操作）
# 启用条件：GITHUB_APP_ENABLED=true 且设置以下所有字段
GITHUB_APP_ID=your_app_id
GITHUB_APP_PRIVATE_KEY=your_private_key_pem
GITHUB_APP_CLIENT_ID=your_client_id
GITHUB_APP_CLIENT_SECRET=your_client_secret
GITHUB_APP_WEBHOOK_SECRET=your_webhook_secret
GITHUB_APP_INSTALLATION_ID=your_installation_id
GITHUB_APP_REDIRECT_URI=http://localhost:3000/api/auth/github-app/callback
# 是否启用 GitHub App 登录（启用后，GitHub 登录必须绑定已有账户）
GITHUB_APP_ENABLED=false

# Better Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Clerk 认证（可选，完整集成）
# 启用条件：CLERK_ENABLED=true 且设置以下所有字段
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=
# 是否启用 Clerk（true/false）
CLERK_ENABLED=false

# Supabase（可选）
# 启用条件：设置 SUPABASE_URL 和 SUPABASE_ANON_KEY
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 终端 WebSocket 地址（用于 Web 终端功能）
# 本地开发默认: ws://localhost:7860/api/terminal/ws
# Docker 环境默认: ws://localhost:7860/api/terminal/ws
TERMINAL_WS_URL=ws://localhost:7860/api/terminal/ws

# 日志
LOG_LEVEL=info
